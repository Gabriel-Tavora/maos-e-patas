# A imagem oficial do nginx troca ${PORT} e ${BACKEND_URL} pelas variaveis de ambiente ao iniciar.
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        # O navegador fala so com este nginx (mesma origem). Sem o Origin, o Spring nao aplica a
        # regra de CORS, que so libera http://localhost:5173 (SecurityConfig).
        proxy_set_header Origin "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # Rotas do React Router (/clientes, /agenda...) caem no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
